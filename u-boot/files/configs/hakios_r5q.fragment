# U-Boot for Samsung Galaxy S10 Lite r5q (SM8150).
# ABL supplies the handset's live DTB when it starts this boot image.
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8150-mtp"
CONFIG_CMD_HAKIOS=y
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_LMB=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/hakios_r5q.env"
CONFIG_BOOTDELAY=0
CONFIG_BOOTCOMMAND="hakios load && hakios boot"
CONFIG_CMD_BOOTMENU=y
CONFIG_LINUX_KERNEL_IMAGE_HEADER=y
